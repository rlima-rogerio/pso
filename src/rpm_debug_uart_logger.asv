%% RPM Debug Receiver (TM4C123 WTIMER capture -> UART CSV) + parse + save + plots
% Firmware expected CSV lines (one per capture event):
%   t_ticks,edge,level,flags,ovf
% where:
%   t_ticks : uint32 timer ticks (WTIMERx_TAR)
%   edge    : 1=RISE, 0=FALL  (often inferred as edge=level)
%   level   : GPIO level after capture (0/1)
%   flags   : uint16 (0 for now)
%   ovf     : fifo overflow counter
%
% This script:
%  - collects for duration_s
%  - parses into table
%  - reconstructs pulse widths + midpoints (ACTIVE_HIGH or ACTIVE_LOW)
%  - estimates RPM from midpoint-to-midpoint intervals: RPM = 60/(dT * pulses_per_rev)
%  - saves .mat and .csv
%  - plots diagnostics

function rpm_debug_uart_logger()
    %% -------- USER SETTINGS ----------
    sys = computer;
    switch sys
        case {'PCWIN64', 'PCWIN'}
            port = 'COM3';

        case {'GLNXA64', 'GLNX86'}
            port = '/dev/ttyACM0';

        otherwise
            error('Sistema operacional não suportado: %s', sys);
    end

    baud = 115200;
    duration_s = 20;            % acquisition duration (s)

    f_timer_hz = 40e6;          % WTIMER tick frequency (40 MHz in your current setup)
    pulses_per_rev = 2;         % blades/pulses per revolution (BLADE_NUMBER)
    active_level = "LOW";       % "LOW" if blade produces LOW pulse, "HIGH" if HIGH pulse

    max_lines_hint = 60000;     % prealloc hint (won't error if exceeded)
    max_drain_per_iter = 50;    % how many lines to read per loop iteration (helps responsiveness)

    %% -------- OUTPUT FILES ----------    
    out_dir = fullfile(pwd, "logs_rpm_debug");
    if ~exist(out_dir, "dir"), mkdir(out_dir); end
    ts = datetime("now");
    base = "rpm_debug_" + string(datestr(ts, "yyyy-mm-dd_HH-MM-SS"));
    csv_file = fullfile(out_dir, base + ".csv");
    mat_file = fullfile(out_dir, base + ".mat");

    %% -------- OPEN SERIAL ----------
    s = serialport(port, baud);
    configureTerminator(s, "LF");
    flush(s);

    fprintf("Receiving on %s @ %d baud for %.1f s...\n", port, baud, duration_s);
    fprintf("Saving to:\n  %s\n  %s\n", csv_file, mat_file);

    %% -------- COLLECT LINES ----------
    t0 = tic;
    lines = strings(0,1);
    lines(min(max_lines_hint, 1)) = ""; % (forces string array type)
    lines = strings(0,1); % reset properly

    while toc(t0) < duration_s
        k = 0;
        while s.NumBytesAvailable > 0 && k < max_drain_per_iter
            ln = strtrim(readline(s));
            if ln ~= ""
                lines(end+1,1) d= ln;
            end
            k = k + 1;
        end
    end

    clear s; % closes port
    fprintf("Collected %d lines.\n", numel(lines));

    if numel(lines) == 0
        error("No data received. Check port, baud, and firmware output.");
    end

    %% -------- PARSE CSV LINES ----------
    % Expected 5 comma-separated fields. Ignore malformed lines.
    n = numel(lines);
    t_ticks = zeros(n,1,'uint32');
    edge    = zeros(n,1,'uint8');
    level   = zeros(n,1,'uint8');
    flags   = zeros(n,1,'uint16');
    ovf     = zeros(n,1,'uint32');
    valid   = false(n,1);

    for i = 1:n
        p = split(lines(i), ",");
        if numel(p) < 5, continue; end

        a = str2double(p(1));
        b = str2double(p(2));
        c = str2double(p(3));
        d = str2double(p(4));
        e = str2double(p(5));

        if any(isnan([a b c d e])), continue; end

        t_ticks(i) = uint32(a);
        edge(i)    = uint8(b);
        level(i)   = uint8(c);
        flags(i)   = uint16(d);
        ovf(i)     = uint32(e);
        valid(i)   = true;
    end

    T = table(t_ticks(valid), edge(valid), level(valid), flags(valid), ovf(valid), ...
              'VariableNames', {'t_ticks','edge','level','flags','ovf'});

    writetable(T, csv_file);

    %% -------- TIME BASE ----------
    t_sec = double(T.t_ticks) / f_timer_hz;

    %% -------- RECONSTRUCT ACTIVE PULSES + MIDPOINTS ----------
    isRise = (T.edge == 1);
    isFall = (T.edge == 0);

    mid_t = zeros(0,1);
    w_act = zeros(0,1);

    have_start = false;
    t_start = 0;

    for i = 1:numel(t_sec)
        if active_level == "LOW"
            % LOW pulse: FALL -> RISE
            if isFall(i)
                t_start = t_sec(i);
                have_start = true;
            elseif isRise(i) && have_start
                t_end = t_sec(i);
                width = t_end - t_start;
                mid_t(end+1,1) = t_start + 0.5*width; %#ok<AGROW>
                w_act(end+1,1) = width;               %#ok<AGROW>
                have_start = false;
            end
        else
            % HIGH pulse: RISE -> FALL
            if isRise(i)
                t_start = t_sec(i);
                have_start = true;
            elseif isFall(i) && have_start
                t_end = t_sec(i);
                width = t_end - t_start;
                mid_t(end+1,1) = t_start + 0.5*width; %#ok<AGROW>
                w_act(end+1,1) = width;               %#ok<AGROW>
                have_start = false;
            end
        end
    end

    %% -------- RPM ESTIMATION FROM MIDPOINTS ----------
    if numel(mid_t) >= 2
        dmid = diff(mid_t);                     % seconds
        rpm_est = 60 ./ (dmid * pulses_per_rev);
        t_rpm = mid_t(2:end);
    else
        dmid = [];
        rpm_est = [];
        t_rpm = [];
    end

    %% -------- SAVE MAT ----------
    save(mat_file, "T", "lines", "t_sec", "mid_t", "w_act", "dmid", "rpm_est", "t_rpm", ...
        "port","baud","duration_s","f_timer_hz","pulses_per_rev","active_level");

    %% -------- PLOTS ----------
    % 1) Edge timeline
    figure;
    plot(t_sec, double(T.edge), '.');
    xlabel('Time (s)'); ylabel('Edge (1=RISE, 0=FALL)');
    title('Captured edges');

    % 2) Active pulse width histogram (us)
    if ~isempty(w_act)
        figure;
        histogram(w_act * 1e6);
        xlabel('Active pulse width (\mus)'); ylabel('Count');
        title("Active pulse width histogram (" + active_level + ")");
    end

    % 3) Active pulse width vs time
    if ~isempty(w_act)
        figure;
        plot(mid_t, w_act * 1e6, '.');
        xlabel('Time (s)'); ylabel('Active pulse width (\mus)');
        title("Active pulse width vs time (" + active_level + ")");
    end

    % 4) Midpoint interval histogram (ms)
    if ~isempty(dmid)
        figure;
        histogram(dmid * 1e3);
        xlabel('\Delta midpoint (ms)'); ylabel('Count');
        title('Midpoint-to-midpoint interval histogram');
    end

    % 5) Estimated RPM vs time
    if ~isempty(rpm_est)
        figure;
        plot(t_rpm, rpm_est, '.-');
        xlabel('Time (s)'); ylabel('RPM');
        title('Estimated RPM (from midpoint intervals)');
        grid on;
    end

    % 6) FIFO overflow counter over time (if it changes)
    if any(diff(double(T.ovf)) ~= 0)
        figure;
        plot(t_sec, double(T.ovf), '.-');
        xlabel('Time (s)'); ylabel('FIFO overflow count');
        title('FIFO overflow counter');
        grid on;
    end

    fprintf("Done.\nCSV: %s\nMAT: %s\n", csv_file, mat_file);
end
